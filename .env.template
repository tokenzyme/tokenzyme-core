# Copy this file to .env and fill in the values.
#
#   cp .env.template .env
#
# .env is git-ignored. Never commit real credentials.
# Every variable without a documented default is required — the server refuses to
# start if one is missing.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# "development" or "production". Defaults to "development".
NODE_ENV="development"

# Pino log level: trace | debug | info | warn | error | fatal. Defaults to "info".
LOG_LEVEL="info"

# Log every Prisma query. Noisy — useful when debugging the data layer.
LOG_PRISMA="false"

# Origin allowed by CORS and by the WebSocket gateway, e.g. "https://example.com".
# Required when NODE_ENV=production. Leave empty in development to accept any origin.
CORS_ORIGIN=""

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string. To run the database locally:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres --name postgres postgres:17.5
DB_URL="postgresql://postgres:postgres@localhost:5432/tokenzyme?schema=tokenzyme"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Users authenticate by signing a nonce with their wallet; the API then issues a JWT.

# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=""

# JWT lifetime, as accepted by @nestjs/jwt, e.g. "7d" or "24h".
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: AWS S3, DigitalOcean Spaces, MinIO, Cloudflare R2)
# ---------------------------------------------------------------------------

STORAGE_BUCKET=""
STORAGE_REGION=""

# S3 API endpoint, e.g. "https://nyc3.digitaloceanspaces.com"
STORAGE_ENDPOINT=""

# Public base URL images are served from, e.g. "https://cdn.example.com"
STORAGE_CDN_URL=""

STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------
# RPC_URL and PRICE_FEED_ADDRESS must point at the same network the indexer and the
# clients are configured for. Uncomment the block you want.

# Local fork (chain ID 1337) — run `yarn test:fork:startNode` in tokenzyme-contracts
# RPC_URL="http://127.0.0.1:8545"
# PRICE_FEED_ADDRESS="0xc76dFb89fF298145b417d221B2c747d84952e01d"

# Sonic mainnet (chain ID 146)
# RPC_URL="https://rpc.soniclabs.com"
# PRICE_FEED_ADDRESS="0xc76dFb89fF298145b417d221B2c747d84952e01d"

# Sonic testnet (chain ID 14601)
# RPC_URL="https://rpc.testnet.soniclabs.com"
# PRICE_FEED_ADDRESS=""

# Sonic Blaze testnet (chain ID 57054, legacy)
# RPC_URL="https://rpc.blaze.soniclabs.com"
# PRICE_FEED_ADDRESS="0xC13a2Af6076E1dc5673eA9f3476a60299eADf7AE"
