{
  "name": "tokenzyme-core",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -Rf ./dist && nest build",
    "format": "prettier --write './**/*.{ts,cts,mts,js,cjs,mjs,json,yml,yaml}'",
    "image:build": "docker buildx build --platform=linux/amd64 --provenance=false -t \"${DOCKER_IMAGE:-tokenzyme-core:latest}\" .",
    "image:publish": "docker push \"${DOCKER_IMAGE:-tokenzyme-core:latest}\"",
    "lint": "eslint .",
    "prisma:format": "prisma format",
    "prisma:generate": "rm -Rf ./src/generated/prisma && prisma format && prisma generate --sql",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create-only": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node ./dist/index.js"
  },
  "dependencies": {
    "@apollo/server": "4.12.2",
    "@as-integrations/fastify": "3.0.0",
    "@aws-sdk/client-s3": "3.878.0",
    "@aws-sdk/s3-request-presigner": "3.878.0",
    "@fastify/multipart": "9.0.3",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/websockets": "11.1.6",
    "@prisma/adapter-pg": "6.15.0",
    "@prisma/client": "6.15.0",
    "dataloader": "2.2.3",
    "dotenv": "17.2.1",
    "ethers": "6.15.0",
    "fastify": "5.4.0",
    "graphql": "16.11.0",
    "graphql-scalars": "1.24.2",
    "json-bigint-patch": "0.0.8",
    "lodash.escaperegexp": "4.1.2",
    "lodash.keyby": "4.6.0",
    "lodash.snakecase": "4.1.1",
    "luxon": "3.7.1",
    "nestjs-pino": "4.4.0",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "pino-pretty": "13.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.3",
    "socket.io": "4.8.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/lodash.escaperegexp": "4.1.9",
    "@types/lodash.keyby": "4.6.9",
    "@types/lodash.snakecase": "4.1.9",
    "@types/luxon": "3.7.1",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.6.2",
    "prisma": "6.15.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.2"
  }
}
