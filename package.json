{
  "name": "tokenzyme-core",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -Rf ./dist && nest build",
    "format": "prettier --write './**/*.{ts,cts,mts,js,cjs,mjs,json,yml,yaml}'",
    "image:build": "docker buildx build --platform=linux/amd64 --provenance=false -t \"${DOCKER_IMAGE:-tokenzyme-core:latest}\" .",
    "image:publish": "docker push \"${DOCKER_IMAGE:-tokenzyme-core:latest}\"",
    "lint": "eslint .",
    "prisma:format": "prisma format",
    "prisma:generate": "rm -Rf ./src/generated/prisma && prisma format && prisma generate --sql",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create-only": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node ./dist/index.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.0",
    "@as-integrations/fastify": "3.1.0",
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@fastify/multipart": "9.4.0",
    "@nestjs/apollo": "13.4.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/graphql": "13.4.2",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "dataloader": "2.2.3",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "fastify": "5.10.0",
    "graphql": "16.14.2",
    "graphql-scalars": "1.25.0",
    "json-bigint-patch": "0.0.9",
    "lodash.escaperegexp": "4.1.2",
    "lodash.keyby": "4.6.0",
    "lodash.snakecase": "4.1.1",
    "luxon": "3.7.2",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "socket.io": "4.8.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/lodash.escaperegexp": "4.1.9",
    "@types/lodash.keyby": "4.6.9",
    "@types/lodash.snakecase": "4.1.9",
    "@types/luxon": "3.7.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-deprecation": "2.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
