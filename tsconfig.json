{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "module": "CommonJS",
    "noUncheckedIndexedAccess": true,
    "outDir": "./dist",
    "paths": {
      "@cloud/*": ["./src/cloud/*"],
      "@core/*": ["./src/core/*"],
      "@domains/*": ["./src/domains/*"],
      "@prisma": ["./src/generated/prisma"],
      "@prisma/*": ["./src/generated/prisma/*"],
      "@typechain": ["./src/generated/typechain"],
      "@typechain/*": ["./src/generated/typechain/*"]
    },
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": ["./src"]
}
